# ========== AURA Configuration ==========
# See BEST_PRACTICES.md for detailed documentation
# See SECURITY.md for security requirements

# ===== REQUIRED (Production) =====
# Backend Campus Controller API endpoint - MUST be set, no fallback
CAMPUS_CONTROLLER_URL=https://campus.example.com/api

# Allowed frontend origins (comma-separated)
# Example: https://aura.example.com,https://aura-backup.example.com
# CRITICAL: Set this to specific origins in production (not wildcards)
CORS_ORIGINS=http://localhost:3000

# PostgreSQL connection string for persisted monitoring / SLE history.
# On Railway, reference the attached Postgres service rather than hard-coding:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# REQUIRED in production. The server exits at boot without it — falling back to
# volatile memory would silently lose the history this feature exists to keep.
DATABASE_URL=

# ===== RECOMMENDED (Production) =====
# Runtime environment
NODE_ENV=development

# Server port
PORT=3000

# Sentry DSN for error tracking and performance monitoring (optional)
# Get your DSN from https://sentry.io/
# Example: https://xxxx@yyyy.ingest.sentry.io/nnnn
# VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ===== Rate Limiting (Optional, Production) =====
# Rate limit time window in milliseconds
# Default: 900000 (15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per rate limit window
# Default: 100 requests
RATE_LIMIT_MAX_REQUESTS=100

# ===== Monitoring Persistence =====
# See docs/MONITORING_PERSISTENCE.md. Every value below is validated at boot;
# an invalid one aborts startup rather than silently defaulting.

# Rolling detailed-retention window, in days. Applied at write time via
# metric_samples.expires_at, so changing it affects newly collected data only.
MONITORING_RETENTION_DAYS=7

# How often the collector polls each source.
MONITORING_POLL_INTERVAL_SECONDS=300

# Per-request timeout against a controller.
MONITORING_REQUEST_TIMEOUT_SECONDS=15

# Maximum sources polled concurrently.
MONITORING_MAX_CONCURRENCY=4

# Bounded exponential backoff with jitter after a failure.
MONITORING_FAILURE_BACKOFF_SECONDS=60
MONITORING_MAX_BACKOFF_SECONDS=1800

# Age after which stored data is presented as stale rather than current.
MONITORING_STALE_AFTER_SECONDS=900

# Master switches. Disabling collection stops writes; it never deletes data.
MONITORING_COLLECTOR_ENABLED=true
MONITORING_CLEANUP_ENABLED=true

# Run the collector inside the web service instead of a separate Railway
# worker. Both take the same PostgreSQL advisory lock, so either is safe.
MONITORING_COLLECTOR_IN_PROCESS=false

# Per-AP report collection. Off by default — it is the volume driver
# (~18 series per AP).
MONITORING_AP_REPORTS_ENABLED=false

# Credentials the collector uses to poll controllers while nobody is logged in.
# CAMPUS_CONTROLLER_USER / CAMPUS_CONTROLLER_PASSWORD are accepted as aliases.
# MONITORING_CONTROLLER_USERNAME=
# MONITORING_CONTROLLER_PASSWORD=

# AES-256-GCM key for per-source credentials stored via the monitoring API.
# Generate with: openssl rand -base64 32
# MONITORING_CREDENTIAL_KEY=

# Client-level history. Off by default: no MAC or username is persisted.
# When enabled, a salt is REQUIRED and identifiers are stored as HMAC pseudonyms.
MONITORING_PERSIST_CLIENT_IDENTIFIERS=false
# MONITORING_CLIENT_PSEUDONYM_SALT=

# Require a verifiable TLS chain when the collector reaches a controller.
# Left off by default because Campus Controllers commonly present self-signed
# certificates and the rest of AURA already accepts them (server.js proxies with
# `secure: false`). Set to true where your controllers have real certificates.
MONITORING_TLS_REJECT_UNAUTHORIZED=false

# ===== TLS/SSL (Production) =====
# Only disable in development with self-signed certificates
# NEVER set to '0' in production
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Path to custom CA certificate (production)
# TLS_CA_CERT=/etc/ssl/certs/ca.crt

# ===== Logging (Optional) =====
# Server log level: 'debug' | 'info' | 'warn' | 'error'
# Default: 'info'
# LOG_LEVEL=info

# ===== LLM Provider Keys (any subset — picker shows configured providers) =====
# server.js reads process.env directly; export these in the shell you launch
# `node server.js` from, or set them in your process manager (Railway, pm2, ...).
# Local-dev shortcut:
#   export OLLAMA_ENABLED=true OLLAMA_API_BASE=http://192.168.100.177:11434/v1 && npm run start

# ANTHROPIC_API_KEY=          # Claude Sonnet 4.6 / Opus 4.7 / Haiku 4.5
# OPENAI_API_KEY=             # GPT-4o family
# GROQ_API_KEY=               # gsk_… → Groq Cloud (Llama 3.x, Mixtral, GPT-OSS)
# GROK_API_KEY=               # xai-… → xAI Grok 3 / 3 Mini
# GEMINI_API_KEY=             # Google Gemini 2.0 Flash / 1.5 Pro (generous free tier)
# MISTRAL_API_KEY=            # Mistral Small / 7B / Large
# CEREBRAS_API_KEY=           # Cerebras-hosted Llama 3.3 70B / 3.1 8B (ultra-fast)
# DEEPSEEK_API_KEY=           # DeepSeek V3 / R1 reasoner

# Local Ollama on the redq box (no API key needed)
# OLLAMA_ENABLED=true
# OLLAMA_API_BASE=http://192.168.100.177:11434/v1

# ===== DEPRECATED - DO NOT USE =====
# These variables should NEVER be used. They are exposed to the browser.
# VITE_CAMPUS_CONTROLLER_USER=  # NEVER use - exposed in client JS
# VITE_CAMPUS_CONTROLLER_PASSWORD=  # NEVER use - exposed in client JS
